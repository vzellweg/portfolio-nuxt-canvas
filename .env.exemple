# Public site configuration
NUXT_PUBLIC_SITE_URL="http://localhost:3000"
NUXT_PUBLIC_AVAILABLE="true"
NUXT_PUBLIC_MEETING_LINK="your_meeting_link"

# Contact form (Resend) — server-side only
NUXT_RESEND_API_KEY="your_resend_api_key"

# Nuxt Studio — GitHub OAuth app credentials (production editing only).
# Callback URL of the OAuth app: https://<domain>/__nuxt_studio/auth/github
STUDIO_GITHUB_CLIENT_ID="your_github_oauth_client_id"
STUDIO_GITHUB_CLIENT_SECRET="your_github_oauth_client_secret"
# Optional: restrict Studio to these GitHub account emails (comma-separated)
# STUDIO_GITHUB_MODERATORS="vazellweg@gmail.com"
